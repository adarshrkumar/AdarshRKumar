{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|NotebookEdit|Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-absolute-paths.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-bash-bypass-cmds.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-git-ops.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-all-cd.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/check-empty-agents-dir.js",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-stop.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx drizzle-kit:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(npm run check)",
      "Bash(npx astro:*)",
      "Bash(git:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "mcp__ide__getDiagnostics",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(* git add *)",
      "Bash(* git commit *)",
      "Bash(npm run check 2>&1 | *)",
      "Bash(* npm run check 2>&1 | *)"
    ],
    "ask": [
      "Edit(eslint/**/*.js)",
      "Edit(eslint*js)"
    ]
  }
}
