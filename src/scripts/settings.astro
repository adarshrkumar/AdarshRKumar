<script is:inline>
    window.setTheme = _t => {}
    window.settingsKey = 'settings'

    window.settingFunctions = {
        theme: theme => window.setTheme(theme)
    }

    window.getSettings = function() {
        return JSON.parse(localStorage.getItem(window.settingsKey) || '[]')
    }

    window.applySettings = function() {
        window.getSettings().forEach(s => {
            var sName = s.name
            var sContent = s.content
            window.settingFunctions[sName](sContent)
        })
    }

    window.setSetting = function(name, value, type, key) {
        var settings = window.getSettings()

        var sIndex = 'nothing'
        settings.forEach((s, i) => {
            var sName = s.name
            if (sName === name) sIndex = i
        })

        if (isNaN(sIndex)) {
            var settingsLength = settings.length
            settings.push({name: name})
            sIndex = settingsLength
        }

        if (!!settings[sIndex].content === false) {
            switch(type) {
                case 'object':
                    settings[sIndex].content = {}
                    break
                case 'list':
                    settings[sIndex].content = []
                    break
                default:
                    settings[sIndex].content = ''
                    break
            }
        }

        switch(type) {
            case 'object':
                settings[sIndex].content[key] = value
                break
            case 'list':
                settings[sIndex].content.push(value)
                break
            default:
                settings[sIndex].content = value
                break
        }

        settings = JSON.stringify(settings)
        localStorage.setItem(window.settingsKey, settings)
    }

    window.applySettings()
</script>
