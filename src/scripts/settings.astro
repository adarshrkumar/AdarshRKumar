<script is:inline>
    window.setTheme = _t => {}
    window.settingsKey = 'settings'

    window.settingFunctions = {
        theme: theme => {
            window.setTheme(theme)
        }
    }

    window.getSettings = function() {
        var settings = localStorage.getItem(window.settingsKey)
        settings = !!settings ? settings : '[]'
        settings = JSON.parse(settings)
        return settings
    }

    window.applySettings = function() {
        var settings = window.getSettings()
        settings.forEach(s => {
            var sName = s.name
            var sContent = s.content
            window.settingFunctions[sName](sContent)
        })
    }

    window.setSetting = function(name, value, type, key) {
        var settings = window.getSettings()

        var sIndex = 'nothing'
        settings.forEach((s, i) => {
            var sName = s.name
            if (sName === name) sIndex = i
        })

        if (isNaN(sIndex)) {
            var settingsLength = settings.length
            settings.push({name: name})
            sIndex = settingsLength
        }

        var setting = settings[sIndex]
        var content = setting.content
        if (!!content === false) {
            switch(type) {
                case 'object':
                    content = {}
                    break
                case 'list':
                    content = []
                    break
                default:
                    content = ''
                    break
            }
        }

        switch(type) {
            case 'object':
                content[key] = value
                break
            case 'list':
                content.push(value)
                break
            default:
                content = value
                break
        }

        setting.content = content
        settings[sIndex] = setting
        settings = JSON.stringify(settings)
        localStorage.setItem(window.settingsKey, settings)
    }

    window.applySettings()
</script>
