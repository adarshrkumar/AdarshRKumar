---
import { getFeaturedPosts, cleanTextContent, createPreviewContent } from '../lib/get-posts'
import sanitizeMD from '../lib/sanitize-md'

import SiteGridContent from '../components/SiteGridContent.astro'

const featuredPostSlugs = ['a-drive-for-mac-issue', 'hello-world', 'nodebooks']

---
<SiteGridContent classItems="posts" options={{ 'max-width': '1200px' }}>
    {
        (await getFeaturedPosts(featuredPostSlugs, Astro.site)).map(async post => {
            const cleanedTextContent = cleanTextContent(sanitizeMD(post.rawContent()))

            return (
                <a href={`/post/${post.slug}`} class="item">
                    <img class="item__img" src={post.screenshotImage!.src} alt={post.screenshotImage!.alt} style={`--placeholder: url('${post.screenshotImage!.placeholder}')`} />
                    {(post.frontmatter.title || cleanedTextContent) && (
                        <div class="item__info">
                            {post.frontmatter.title && (
                                <h3 class="item__title">{post.frontmatter.title}</h3>
                            )}
                            {createPreviewContent(cleanedTextContent) && (
                                <p class="item__content">{createPreviewContent(cleanedTextContent)}</p>
                            )}
                        </div>
                    )}
                </a>
            )
        })
    }
</SiteGridContent>
