---
import { getFeaturedPostsForDisplay, cleanTextContent, createPreviewContent } from '../lib/get-posts'
import sanitizeMD from '../lib/sanitize-md'

import SiteGridContent from '../components/SiteGridContent.astro'

const featuredPostSlugs = ['a-drive-for-mac-issue', 'hello-world', 'nodebooks']

---
<SiteGridContent classItems="posts" options={{ 'max-width': '1200px' }}>
    {
        (await getFeaturedPostsForDisplay(featuredPostSlugs, Astro.site)).map(async post => {
            const rawTextContent = sanitizeMD(post.rawContent())
            const cleanedTextContent = cleanTextContent(rawTextContent)
            const previewContent = createPreviewContent(cleanedTextContent)

            const hasContent = !!(post.frontmatter.title || cleanedTextContent)
            const hasTitle = !!post.frontmatter.title
            const hasPreview = !!previewContent

            return (
                <a href={`/post/${post.slug}`} class="item">
                    <img class="item__img" src={post.screenshotImage.src} alt={post.screenshotImage.alt} style={`--placeholder: url('${post.screenshotImage.placeholder}')`} />
                    {hasContent && (
                        <div class="item__info">
                            {hasTitle && (
                                <h3 class="item__title">{post.frontmatter.title}</h3>
                            )}
                            {hasPreview && (
                                <p class="item__content">{previewContent}</p>
                            )}
                        </div>
                    )}
                </a>
            )
        })
    }
</SiteGridContent>