---
// Imports
import '../styles/components/theme-switcher.scss'
import ThemeSwitcherScript from '../scripts/theme-switcher.astro'

---
<div class="theme-switcher">
    <svg class="theme-switcher__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"></svg>
</div>
<ThemeSwitcherScript />

<style>
    .theme-switcher {
        display: block;
    }

    @supports not (color: if(media(print): red; blue)) {
        .theme-switcher {
            display: none !important;
        }
    }
</style>