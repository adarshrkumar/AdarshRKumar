---
import type { GridOptions } from '../lib/types'

import '../styles/components/grid.scss'

const { id, classItems, options } = Astro.props

let customProperties = ''

if (options && typeof options === 'object') Object.keys(options).forEach((key, index) => {
    if (index !== 0) customProperties += ' '
    const value = options[key as keyof GridOptions]

    if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
        const nestedKeys = Object.keys(value)
        nestedKeys.forEach(nestedKey => {
            const val = value ? String(Object.getOwnPropertyDescriptor(value, nestedKey)?.value ?? '') : ''
            customProperties += `--${key}-${nestedKey}: ${val}; `
        })
    }
    else customProperties += `--${key}: ${value};`;
})

const cssClass = `grid${classItems ? ` ${classItems}` : ''}`

---
<section id={id || ''} class={cssClass} style={customProperties}>
    <slot />
</section>