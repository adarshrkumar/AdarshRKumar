---
// Imports
import LargeFrame from '../components/largeFrame.astro'
import '../styles/pages/youtube.scss'
import type { RSSResponse } from '../lib/types'

// Component props and configuration
// Get component props
const { id: channelId, vidsPerChannel } = Astro.props

// Set default videos per channel
const maxVideosPerChannel = vidsPerChannel || 'all'

// Data fetching
// Fetch channel data
let channel: { feed: RSSResponse; videos: Array<{ link?: string; title?: string }> } = { feed: { status: 'error' }, videos: [] }

try {
    const apiKey = 'MDNyZ2p6bjJyZ21jYWpqOXR2aTNkbmNncW00NTBqMThxaDllenNoZA=='
    const channelURL = `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`
    const rssUrl = `https://api.rss2json.com/v1/api.json?api_key=${atob(apiKey)}&rss_url=${encodeURIComponent(channelURL)}`

    const response = await fetch(rssUrl)
    const result = await response.json()

    if (result && result.status === 'ok' && result.feed && result.items && result.items.length > 0) {
        channel = result
    }
    else {
        console.warn(`No valid videos found for channel: ${channelId}`)
    }
} catch (error) {
    console.error(`Error fetching videos for channel ${channelId}:`, error)
}

---

<!-- Channel videos component -->
{
    channel.videos.map((video, videoIndex) => {
        if (typeof maxVideosPerChannel !== 'string' && videoIndex >= maxVideosPerChannel) {
            return ''
        }

        return (
            <LargeFrame
                video={video}
                feed={channel.feed}
            />
        )
    })
}