---
import { getImage } from 'astro:assets'

import { getAllPhotos } from '../lib/get-photos'

import '../styles/pages/photos.scss'
import SiteGridContent from '../components/SiteGridContent.astro'
import AnimatedCard from '../components/motion/AnimatedCard.astro'
import Layout from '../layouts/Layout.astro'

interface PhotoMetadata {
    title?: string;
    location?: string;
    info?: string;
    fullname?: string;
    name?: string;
    category?: string;
    uploader?: string;
}

interface PhotoImport {
    src: string;
    [key: string]: string | undefined;
}

interface PhotoItem {
    src?: string;
    alt?: string;
    fullname?: string;
    import?: PhotoImport;
    data?: PhotoMetadata;
}

---

<Layout title="Photos">
    <SiteGridContent classItems="photos" options={{min: '18rem'}}>
        {
            (await getAllPhotos()).map(async (p, i) => {
                const photo: PhotoItem = {
                    src: p.imageUrl,
                    alt: p.title || p.name,
                    fullname: p.fullname,
                    import: { src: p.imageUrl },
                    data: {
                        title: p.title,
                        fullname: p.fullname,
                        name: p.name,
                        category: p.category,
                        uploader: p.uploader,
                    }
                }
                if (!photo.src) return ''

                const photoData = photo.data

                const optimizedImage = await getImage({
                    src: photo.import?.src || photo.src || '',
                    width: 400,
                    height: 400,
                    format: 'webp',
                    quality: 85
                })

                const hasMetadata = !!(photoData?.title || photoData?.info)
                const hasTitle = !!photoData?.title
                const hasLocation = !!photoData?.location

                return (
                    <AnimatedCard index={i} class="item photos__item">
                        <label style="display: contents;">
                            <input type="checkbox" class="photos__checkbox" />
                            <img class="photos__img loading" src={photo.src || ''} alt={photo.alt || photoData?.title || `Photo: ${photo.fullname}`} loading="lazy" decoding="async" style={`--placeholder: url('${optimizedImage.src}');`} />
                            {hasMetadata && (
                                <div class="photos__info">
                                    {hasTitle && (
                                        <h3 class="photos__title">{photoData.title}</h3>
                                    )}
                                    {hasLocation && (
                                        <span class="photos__content">📍 {photoData.location}</span>
                                    )}
                                </div>
                            )}
                        </label>
                    </AnimatedCard>
                )
            })
        }
    </SiteGridContent>
</Layout>
<script>
    document.addEventListener('astro:page-load', () => {
        const images = document.querySelectorAll<HTMLImageElement>('.photos__img');

        images.forEach(img => {
            if (img.complete && img.naturalHeight !== 0) {
                img.classList.remove('loading');
                img.classList.add('loaded');
            }
            else {
                img.addEventListener('load', () => {
                    img.classList.remove('loading');
                    img.classList.add('loaded');
                });

                img.addEventListener('error', () => {
                    img.classList.remove('loading');
                    console.warn('Image failed to load:', img.src);
                });
            }
        });
    });
</script>