---
import type { Author } from '../../lib/types'
import authors from '../../lib/authors'

import Layout from '../../layouts/Layout.astro'
import '../../styles/pages/author.scss'

const { username } = Astro.params;
const author: Author = authors[username as keyof typeof authors];

---

<Layout title={author.displayName} pageType="author" classItems="ignorepadding">
    {(author.pfp && author.pfp.filename) && (
        <div class="author__pfp">
            <img
                class="author__pfp-inner"
                src={`/profiles/${username}/imgs/${author.pfp.filename}`}
                alt={`${username}'s Profile Picture`}
            />
        </div>
    )}

    <h2 class="author__name">{author.displayName}</h2>

    {author.bio && (
        <div class="bio" set:html={author.bio.includes('\n') ? author.bio.split('\n').join('<br>') : author.bio}></div>
    )}
</Layout>