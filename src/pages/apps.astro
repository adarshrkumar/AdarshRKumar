---
// Imports
import type { PortfolioItem } from '../lib/types'
import filterVisibleItems from '../lib/filter-visible-content-items'
import sanitizeMD from '../lib/sanitize-md'

import '../styles/pages/projects.scss'
import Layout from '../layouts/Layout.astro'
import SiteGridContent from '../components/siteGridContent.astro'
import AnimatedCard from '../components/motion/AnimatedCard.astro'
import FadeIn from '../components/motion/FadeIn.astro'
import AnimatedTitle from '../components/motion/AnimatedTitle.astro'
import appsList from '../../content/work/appsList.json'

// Helper functions
function determineLinkTarget(url: string, siteUrl: string | URL | undefined): string {
    let target = '_blank'
    if (url.startsWith('//')) url = `https:${url}`
    let domain = url
    if (domain.includes('://')) {
        domain = domain.split('://')[1].split('/')[0]
        if (domain.startsWith('www.')) domain = domain.slice(4)
        const sUrl = siteUrl?.toString() || ''
        if (sUrl.includes(domain)) target = '_self'
    }
    else target = '_self';
    return target
}

function generateScreenshotUrl(url: string, imageSize: number = 512): string {
    let fullUrl = url
    if (url.startsWith('/')) {
        const baseUrl = Astro.site?.toString() || 'https://adarshrkumar.dev'
        fullUrl = `${baseUrl.replace(/\/$/, '')}${url}`
    }
    return `https://webshot.adarshrkumar.dev/api/take?url=${encodeURIComponent(fullUrl)}&viewport_width=${imageSize}&viewport_height=${imageSize}`
}

// Load all potential app sources
const portfolioItems = Object.values(import.meta.glob('../../content/work/portfolio/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'frontmatter' in item))
const projectItems = Object.values(import.meta.glob('../../content/work/projects/*/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'frontmatter' in item))

const webApps =
    filterVisibleItems([...portfolioItems, ...projectItems])
    .filter(item => (appsList.some(appName => item.frontmatter.name.toLowerCase().includes(appName))))

// Deduplicate by name
const uniqueApps = Array.from(new Map(webApps.map(item => [item.frontmatter.name, item])).values())
    .sort((a, b) => a.frontmatter.name.localeCompare(b.frontmatter.name))

---

<Layout title="Apps">
    <section class="category">
        <FadeIn direction="up">
            <AnimatedTitle as="h3" class="category__title">
                Web Applications
            </AnimatedTitle>
        </FadeIn>
        <SiteGridContent classItems="wrap" options={{ min: '18rem' }}>
            {
                uniqueApps.map((item, itemIndex) => {
                    const projectUrl = item.frontmatter.url
                    const linkTarget = item.frontmatter.target || determineLinkTarget(projectUrl, Astro.site)
                    const screenshotUrl = generateScreenshotUrl(projectUrl)
                    const placeholderUrl = `${screenshotUrl}&image_quality=50`

                    return (
                        <AnimatedCard index={itemIndex} class="item" href={projectUrl} target={linkTarget}>
                            <img
                                src={screenshotUrl}
                                alt={`Screenshot of ${item.frontmatter.name}`}
                                class="item__img"
                                style={`--placeholder: url('${placeholderUrl}')`}
                            />
                            <div class="item__info">
                                <h3 class="item__title">{item.frontmatter.name}</h3>
                                <p class="item__content">{sanitizeMD(item.rawContent())}</p>
                            </div>
                        </AnimatedCard>
                    )
                })
            }
        </SiteGridContent>
    </section>
</Layout>
