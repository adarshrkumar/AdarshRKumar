---
// // Imports
import type { FormConfig, FormField } from '../lib/types'
import type { HTMLAttributes } from 'astro/types'

import '../styles/pages/about.scss'
import Layout from '../layouts/Layout.astro'
import FancyFace from '../components/fancyFace.astro'
import FadeIn from '../components/motion/FadeIn.astro'
import AnimatedTitle from '../components/motion/AnimatedTitle.astro'
import Input from '../default-components/Input.astro'
import TextArea from '../default-components/TextArea.astro'
// Helper functions
// Load age first
import age from '../lib/get-age'
import categoryMap from '../lib/category-map'

const aboutFile = await import('../../content/aboutContent.md')
const aboutContent = (await aboutFile.compiledContent())?.replaceAll('{ age }', age.toString())

// Skills data
const skillsData = (await import('../../content/skills.json')).default

const skills = Object.entries(skillsData).map(([category, skillList]) => {
    const mapping = categoryMap[category as keyof typeof categoryMap];
    if (!mapping) return null;
    return {
        name: mapping.name,
        icon: mapping.icon,
        tech: skillList
    };
}).filter(Boolean);

// Add the Databases card which is not in the JSON
skills.push({
    name: 'Databases',
    icon: '🗄️',
    tech: [
        { name: 'PostgreSQL', proficiency: 75, icon_url: 'https://skillicons.dev/icons?i=postgres', skill_url: 'https://postgresql.org' },
        { name: 'Drizzle ORM', proficiency: 75, icon_url: 'https://adarshrkumar.dev/assets/readme/DrizzleORM.png', skill_url: 'https://orm.drizzle.team' }
    ]
});

// Interests data
const interests = [
    { name: 'Photography', icon: '📸', link: '/photography/' },
    { name: 'History', icon: '📚', link: null },
    { name: 'Geography', icon: '🌍', link: null },
    { name: 'Technology', icon: '💻', link: '/work/' },
    { name: 'Music', icon: '🎵', link: null },
    { name: 'Astronomy', icon: '🔭', link: null }
]

// CTA buttons
const ctaButtons = [
    { text: 'View Portfolio', link: '/work/portfolio/', primary: true },
    { text: 'Read Blog', link: '/posts/', primary: false },
    { text: 'See Photography', link: '/photography/', primary: false }
]

const skillSpanLength = 9;

// Contact form configuration
const formConfig: FormConfig = {
    action: 'https://docs.google.com/forms/d/e/1FAIpQLSfleYNKUZ6MfijVAEwcIT1Gga4aOhrElpEdayw3_z_vLrs1GA/formResponse',
    method: 'POST',
    className: 'contact'
}

const formFields: Record<string, FormField> = {
    name: {
        type: 'text' as const,
        name: 'entry.183817893',
        id: 'name',
        placeholder: "What's your name?",
        required: 'TRUE',
        align: 'left',
        label: 'Name: '
    },
    email: {
        type: 'email' as const,
        name: 'entry.1021394857',
        id: 'email',
        placeholder: 'you@email.tld',
        required: 'TRUE',
        align: 'left',
        label: 'Email: '
    },
    subject: {
        type: 'honeypot' as const,
        label: 'Subeject:',
        name: 'entry.628171460',
        id: 'subject',
        required: 'FALSE'
    },
    message: {
        type: 'textarea' as const,
        label: 'Message:',
        name: 'entry.1554105426',
        id: 'message',
        placeholder: 'Type here...',
        required: 'TRUE'
    },
    submit: {
        type: 'submit' as const,
        name: 'submit',
        id: 'submit',
        value: 'Send',
        className: 'btn',
        align: 'right',
        style: 'cursor: pointer; margin-left: auto;'
    }
}
---

<Layout title="About">
    <div class="about">
        <FadeIn direction="up" duration={0.6}>
            <div class="about__header">
                <FancyFace />
                <AnimatedTitle as="h1" class="about__name">Adarsh R. Kumar</AnimatedTitle>
                <p class="about__tagline">Web Developer • Photographer • Tech Enthusiast</p>
            </div>
        </FadeIn>

        <FadeIn delay={0.1} direction="up" duration={0.6}>
            <div class="about__bio" set:html={aboutContent} />
        </FadeIn>

        <FadeIn delay={0.2} direction="up" duration={0.6}>
            <section class="about__section">
                <h2 class="about__section-title">Skills & Technologies</h2>
                <div class="about__skills">
                    {skills.map(skill => (
                        <div class="skill-card">
                            <div class="skill-card__icon">{skill?.icon}</div>
                            <h3 class="skill-card__name">{skill?.name}</h3>
                            <ul class="skill-card__tech" data-long={(skill?.tech.map(i => i.name.length > skillSpanLength).filter(Boolean).length ?? 0) % 2 ? 'even' : 'off'}>
                                {skill?.tech.map(item => (
                                    <li style={`--icon: url(${item.icon_url})`} data-long={item.name.length > skillSpanLength ? '' : undefined}>{item.name}</li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </section>
        </FadeIn>

        <FadeIn delay={0.3} direction="up" duration={0.6}>
            <section class="about__section">
                <h2 class="about__section-title">Interests & Hobbies</h2>
                <div class="about__interests">
                    {interests.map(interest => (
                        interest.link ? (
                            <a href={interest.link} class="interest-badge" data-clickable>
                                <span class="interest-badge__icon">{interest.icon}</span>
                                <span class="interest-badge__name">{interest.name}</span>
                            </a>
                        ) : (
                            <div class="interest-badge">
                                <span class="interest-badge__icon">{interest.icon}</span>
                                <span class="interest-badge__name">{interest.name}</span>
                            </div>
                        )
                    ))}
                </div>
            </section>
        </FadeIn>

        <FadeIn delay={0.4} direction="up" duration={0.6}>
            <div class="about__cta">
                {ctaButtons.map(button => (
                    <a href={button.link} class="btn" data-primary={button.primary || undefined}>
                        {button.text}
                    </a>
                ))}
            </div>
        </FadeIn>

        <FadeIn delay={0.5} direction="up" duration={0.6}>
            <section class="about__section">
                <h2 class="about__section-title">Get in Touch</h2>
                <iframe name="hidden_iframe" style="display: none;"></iframe>
                <form action={formConfig.action} method={formConfig.method} class={formConfig.className} target="hidden_iframe">
                    <Input
                        type={formFields.name.type as HTMLAttributes<'input'>['type']}
                        name={formFields.name.name}
                        id={formFields.name.id}
                        placeholder={formFields.name.placeholder}
                        required={formFields.name.required}
                        align={formFields.name.align as 'left' | 'right' | 'center' | undefined}
                    >
                        {formFields.name.label}
                    </Input>

                    <Input
                        type={formFields.email.type as HTMLAttributes<'input'>['type']}
                        name={formFields.email.name}
                        id={formFields.email.id}
                        placeholder={formFields.email.placeholder}
                        required={formFields.email.required}
                        align={formFields.email.align as 'left' | 'right' | 'center' | undefined}
                    >
                        {formFields.email.label}
                    </Input>

                    <Input
                        type={formFields.subject.type as HTMLAttributes<'input'>['type']}
                        name={formFields.subject.name}
                        id={formFields.subject.id}
                        required={formFields.subject.required}
                    >
                        {formFields.subject.label}
                    </Input>

                    <TextArea
                        label={formFields.message.label}
                        rows="1"
                        name={formFields.message.name}
                        id={formFields.message.id}
                        placeholder={formFields.message.placeholder}
                        required={formFields.message.required}
                    />

                    <Input
                        type={formFields.submit.type as HTMLAttributes<'input'>['type']}
                        value={formFields.submit.value}
                        class={formFields.submit.className}
                        align={formFields.submit.align as 'left' | 'right' | 'center' | undefined}
                        style={formFields.submit.style}
                    />
                </form>
            </section>
        </FadeIn>
    </div>
</Layout>