---
// Imports
import '../styles/pages/projects.scss'
import Layout from '../layouts/Layout.astro'
import SiteGridContent from '../components/siteGridContent.astro'
import filterVisibleItems from '../lib/filter-visible-content-items'
import sanitizeMD from '../lib/sanitize-md'
import type { ProjectCategoryConfig, PortfolioItem } from '../lib/types'
import AnimatedCard from '../components/motion/AnimatedCard.astro'
import FadeIn from '../components/motion/FadeIn.astro'
import AnimatedTitle from '../components/motion/AnimatedTitle.astro'

// Helper function to determine link target based on URL
function determineLinkTarget(url: string, siteUrl: string | URL | undefined): string {
    let target = '_blank'

    // Handle protocol-relative URLs
    if (url.startsWith('//')) url = `https:${url}`;

    // Extract domain from URL
    let domain = url
    if (domain.includes('://')) {
        domain = domain.split('://')[1]
        if (domain.includes('/')) domain = domain.split('/')[0];
        if (domain.startsWith('www.')) domain = domain.slice('www.'.length);
        domain = `https://${domain}`
    }

    // Check if it's an internal link
    if (!url.includes(':') || domain === siteUrl?.toString()) target = '_self';

    return target
}

// Helper function to generate screenshot image URL
function generateScreenshotUrl(url: string, imageSize: number = 512): string {
    // Handle relative URLs by prefixing with site URL
    let fullUrl = url
    if (url.startsWith('/')) {
        const baseUrl = Astro.site?.toString() || 'https://adarshrkumar.dev'
        fullUrl = `${baseUrl.replace(/\/$/, '')}${url}`
    }

    return `https://webshot.adarshrkumar.dev/api/take?url=${encodeURIComponent(fullUrl)}&viewport_width=${imageSize}&viewport_height=${imageSize}`
}

// Load portfolio items that have projectsCategory field
const portfolioItems = Object.values(import.meta.glob('../../content/work/portfolio/*.md', { eager: true })).filter((item): item is PortfolioItem => {
    return !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)
})
const portfolioWithCategory = portfolioItems.filter((item): item is PortfolioItem => {
    return !!(item && typeof item === 'object' && 'frontmatter' in item && typeof item.frontmatter === 'object' && item.frontmatter !== null && 'projectsCategory' in item.frontmatter && item.frontmatter.projectsCategory)
})

// Helper to get portfolio items for a specific category
function getPortfolioItemsForCategory(categoryId: string): PortfolioItem[] {
    return portfolioWithCategory.filter((item): item is PortfolioItem => {
        return !!(item && typeof item === 'object' && 'frontmatter' in item && typeof item.frontmatter === 'object' && item.frontmatter !== null && 'projectsCategory' in item.frontmatter && item.frontmatter.projectsCategory === categoryId)
    })
}

// Project categories configuration
const projectCategories: ProjectCategoryConfig[] = [
    {
        id: 'games',
        name: 'Games',
        items: [
            ...Object.values(import.meta.glob('../../content/work/projects/games/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)),
            ...getPortfolioItemsForCategory('games')
        ]
    },
    {
        id: 'large-scale',
        name: 'Large Scale',
        items: [
            ...Object.values(import.meta.glob('../../content/work/projects/large-scale/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)),
            ...getPortfolioItemsForCategory('large-scale')
        ]
    },
    {
        id: 'utilities',
        name: 'Utilities',
        items: [
            ...Object.values(import.meta.glob('../../content/work/projects/utilities/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)),
            ...getPortfolioItemsForCategory('utilities')
        ]
    }
]

---

<Layout title="Projects">
    {
        projectCategories.map((category, categoryIndex) => {
            // Filter out hidden items for this category
            const visibleItems = filterVisibleItems(category.items)

            return (
                <>
                    <section class="category">
                        <FadeIn delay={categoryIndex * 0.1} direction="up">
                            <AnimatedTitle as="h3" class="category__title">
                                {category.name}
                            </AnimatedTitle>
                        </FadeIn>
                        <SiteGridContent classItems="wrap" options={{ min: '18rem' }}>
                            {
                                visibleItems.map((item, itemIndex) => {
                                    const projectUrl = item.frontmatter.url
                                    const linkTarget = item.frontmatter.target || determineLinkTarget(projectUrl, Astro.site)
                                    const screenshotUrl = generateScreenshotUrl(projectUrl)
                                    const placeholderUrl = `${screenshotUrl}&image_quality=50`

                                    return (
                                        <AnimatedCard index={itemIndex} class="item" href={projectUrl} target={linkTarget}>
                                            <img
                                                src={screenshotUrl}
                                                alt={`Screenshot of ${item.frontmatter.name}`}
                                                class="item__img"
                                                style={`--placeholder: url('${placeholderUrl}')`}
                                            />
                                            <div class="item__info">
                                                <h3 class="item__title">{item.frontmatter.name}</h3>
                                                <p class="item__content">{sanitizeMD(item.rawContent())}</p>
                                            </div>
                                        </AnimatedCard>
                                    )
                                })
                            }
                        </SiteGridContent>
                    </section>
                    <div class="divider h" style="--s: 1000px;"></div>
                </>
            )
        })
    }
</Layout>