---
import determineLinkTarget from '../lib/determine-link-target'
import { filterVisibleContentItems, type PortfolioItem } from '../lib/filter-visible-content-items'
import sanitizeMD from '../lib/sanitize-md'

import '../styles/pages/projects.scss'
import SiteGridContent from '../components/SiteGridContent.astro'
import AnimatedCard from '../components/motion/AnimatedCard.astro'
import AnimatedTitle from '../components/motion/AnimatedTitle.astro'
import FadeIn from '../components/motion/FadeIn.astro'
import Layout from '../layouts/Layout.astro'

interface ProjectCategoryConfig {
    id: string;
    name: string;
    items: PortfolioItem[];
}

function generateScreenshotUrl(url: string, imageSize: number = 512): string {
    let fullUrl = url
    if (url.startsWith('/')) {
        const baseUrl = Astro.site?.toString() || 'https://adarshrkumar.dev'
        fullUrl = `${baseUrl.replace(/\/$/, '')}${url}`
    }

    return `https://webshot.adarshrkumar.dev/api/take?url=${encodeURIComponent(fullUrl)}&viewport_width=${imageSize}&viewport_height=${imageSize}`
}

const portfolioItems = Object.values(import.meta.glob('../../content/work/portfolio/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item))
const portfolioWithCategory = portfolioItems.filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'frontmatter' in item && typeof item.frontmatter === 'object' && item.frontmatter !== null && 'projectsCategory' in item.frontmatter && item.frontmatter.projectsCategory))

function getPortfolioItemsForCategory(categoryId: string): PortfolioItem[] {
    return portfolioWithCategory.filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'frontmatter' in item && typeof item.frontmatter === 'object' && item.frontmatter !== null && 'projectsCategory' in item.frontmatter && item.frontmatter.projectsCategory === categoryId))
}

const projectCategories: ProjectCategoryConfig[] = [
    {
        id: 'games',
        name: 'Games',
        items: [
            ...Object.values(import.meta.glob('../../content/work/projects/games/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)),
            ...getPortfolioItemsForCategory('games')
        ]
    },
    {
        id: 'large-scale',
        name: 'Large Scale',
        items: [
            ...Object.values(import.meta.glob('../../content/work/projects/large-scale/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)),
            ...getPortfolioItemsForCategory('large-scale')
        ]
    },
    {
        id: 'utilities',
        name: 'Utilities',
        items: [
            ...Object.values(import.meta.glob('../../content/work/projects/utilities/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)),
            ...getPortfolioItemsForCategory('utilities')
        ]
    },
    {
        id: 'everyday',
        name: 'Everyday Tools',
        items: [
            ...Object.values(import.meta.glob('../../content/work/projects/everyday/*.md', { eager: true })).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)),
            ...getPortfolioItemsForCategory('everyday')
        ]
    }
]

---
<Layout title="Projects">
    {
        projectCategories.map((category, categoryIndex) => {
            return (
                <>
                    <section class="category">
                        <FadeIn delay={categoryIndex * 0.1} direction="up">
                            <AnimatedTitle as="h3" class="category__title">
                                {category.name}
                            </AnimatedTitle>
                        </FadeIn>
                        <SiteGridContent classItems="wrap" options={{ min: '18rem' }}>
                            {
                                filterVisibleContentItems(category.items).map((item, itemIndex) => {
                                    const linkTarget = item.frontmatter.target || determineLinkTarget(item.frontmatter.url, Astro.site)
                                    const screenshotUrl = item.frontmatter.image || generateScreenshotUrl(item.frontmatter.url)

                                    return (
                                        <AnimatedCard index={itemIndex} class="item" href={item.frontmatter.url} target={linkTarget}>
                                            <img src={screenshotUrl} alt={`Screenshot of ${item.frontmatter.name}`} class="item__img" style={`--placeholder: url('${item.frontmatter.image || `${screenshotUrl}&image_quality=50`}')`} />
                                            <div class="item__info">
                                                <h3 class="item__title">{item.frontmatter.name}</h3>
                                                <p class="item__content">{sanitizeMD(item.rawContent())}</p>
                                            </div>
                                        </AnimatedCard>
                                    )
                                })
                            }
                        </SiteGridContent>
                    </section>
                    <div class="divider h" style="--s: 1000px;"></div>
                </>
            )
        })
    }
</Layout>