---
// Imports
import '../styles/pages/index.scss'

import Layout from '../layouts/Layout.astro'

import _Hero from '../components/hero.astro'
import FancyFace from '../components/fancyFace.astro'

import PortfolioHighlights from '../components/portfolioHighlights.astro'
import FeaturedArticles from '../components/featuredArticles.astro'

import FadeIn from '../components/motion/FadeIn.astro'
import AnimatedTitle from '../components/motion/AnimatedTitle.astro'

import * as cheerio from 'cheerio'
import { experimental_AstroContainer as AstroContainer } from 'astro/container';


const readmeFile = await import('../../README.md')
const readmeContent = await readmeFile.compiledContent()

const $ = cheerio.load(readmeContent);
$('h1').first().remove()
$('table').each((_i, table) => {
    $(table).attr('cellspacing', '0')
})
const newReadmeContent = $.html()

const firstPara = $.html($('p').first()).trim();

const container = await AstroContainer.create();
const fancyFaceHTML = await container.renderToString(FancyFace, {
    props: {
        basePath: '/faces/',
        debug: 'false'
    }
});
---

<!-- Home Page Layout -->
<Layout title="" pageType="home">
    <!-- <Hero /> -->

    <FadeIn direction="up" duration={0.6}>
        <div class="readme" set:html={newReadmeContent.replace(firstPara ?? '', `<div class="readme__fancy-column">${fancyFaceHTML}<div><h1>Adarsh R. Kumar</h1>${firstPara}</div></div>`)} />
    </FadeIn>

    <section class="section pHighlights">
        <FadeIn delay={0.1} direction="up">
            <AnimatedTitle as="h2" class="section-title">
                Featured Portfolio Items
            </AnimatedTitle>
        </FadeIn>
        <PortfolioHighlights />
    </section>

    <section class="section bFeatures">
        <FadeIn delay={0.2} direction="up">
            <AnimatedTitle as="h2" class="section-title">
                Featured Blog Posts
            </AnimatedTitle>
        </FadeIn>
        <FeaturedArticles />
    </section>
</Layout>