---
import '../styles/pages/404.scss'
import Layout from '../layouts/Layout.astro'

// URL processing and redirect logic
const currentPath = Astro.url.pathname
const lastPath = currentPath?.split('/').pop() || ''
if (lastPath && !lastPath.includes('.') && !lastPath.endsWith('/')) return Astro.redirect(`${currentPath}/`)
---

<Layout title="404" pTitle="Not Found">
    <section class="error-404">
        <span class="current-URL-not-found">
            <a href=""><span class="page">the requested page</span></a> Cound not be found
        </span>
        <p>Error Type: 404</p>
    </section>
    <script>
        const pageElement = document.querySelector('.page')
        const linkElement = pageElement?.closest('a')

        if (pageElement && linkElement) {
            linkElement.href = location.pathname
            if (!location.pathname.startsWith('/404')) pageElement.textContent = location.pathname
        }
    </script>
</Layout>
