---
import determineLinkTarget from '../lib/determine-link-target'
import { filterVisibleContentItems, type PortfolioItem } from '../lib/filter-visible-content-items'
import sanitizeMD from '../lib/sanitize-md'

import SiteGridContent from '../components/SiteGridContent.astro'
import AnimatedCard from '../components/motion/AnimatedCard.astro'
import Layout from '../layouts/Layout.astro'

function generateScreenshotUrl(url: string, imageSize: number = 512): string {
    let fullUrl = url
    if (url.startsWith('/')) {
        const baseUrl = Astro.site?.toString() || 'https://adarshrkumar.dev'
        fullUrl = `${baseUrl.replace(/\/$/, '')}${url}`
    }

    return `https://webshot.adarshrkumar.dev/api/take?url=${encodeURIComponent(fullUrl)}&viewport_width=${imageSize}&viewport_height=${imageSize}`
}

const portfolioItemsObj = import.meta.glob('../../content/work/portfolio/*.md', { eager: true })
const portfolioItems: PortfolioItem[] = filterVisibleContentItems(Object.values(portfolioItemsObj).filter((item): item is PortfolioItem => !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)))

---

<Layout title="Portfolio">
    <SiteGridContent classItems="portfolio wrap" options={{ min: '18rem' }}>
        {
            portfolioItems.map(async (item, itemIndex) => {
                const linkTarget = item.frontmatter.target || determineLinkTarget(item.frontmatter.url, Astro.site)
                const screenshotUrl = generateScreenshotUrl(item.frontmatter.url)

                return (
                    <AnimatedCard index={itemIndex} class="item" href={item.frontmatter.url} target={linkTarget}>
                        <img src={screenshotUrl} alt={`Screenshot of ${item.frontmatter.name}`} class="item__img" style={`--placeholder: url('${screenshotUrl}&image_quality=50')`} />
                        <div class="item__info">
                            <h3 class="item__title">{item.frontmatter.name}</h3>
                            <p class="item__content">{sanitizeMD(item.rawContent())}</p>
                        </div>
                    </AnimatedCard>
                )
            })
        }
    </SiteGridContent>
</Layout>