---
// Imports
import Layout from '../layouts/Layout.astro'
import SiteGridContent from '../components/siteGridContent.astro'
import filterVisibleItems from '../lib/filter-visible-content-items'
import sanitizeMD from '../lib/sanitize-md'
import type { PortfolioItem } from '../lib/types'
import AnimatedCard from '../components/motion/AnimatedCard.astro'

// Helper functions
// Helper function to determine link target based on URL
function determineLinkTarget(url: string, siteUrl: string | URL | undefined): string {
    let target = '_blank'

    // Handle protocol-relative URLs
    if (url.startsWith('//')) url = `https:${url}`;

    // Extract domain from URL
    let domain = url
    if (domain.includes('://')) {
        domain = domain.split('://')[1]
        if (domain.includes('/')) domain = domain.split('/')[0];
        if (domain.startsWith('www.')) domain = domain.slice('www.'.length);
        domain = `https://${domain}`
    }

    // Check if it's an internal link
    if (!url.includes(':') || domain === siteUrl?.toString()) target = '_self';

    return target
}

// Helper function to generate screenshot image URL
function generateScreenshotUrl(url: string, imageSize: number = 512): string {
    // Handle relative URLs by prefixing with site URL
    let fullUrl = url
    if (url.startsWith('/')) {
        const baseUrl = Astro.site?.toString() || 'https://adarshrkumar.dev'
        fullUrl = `${baseUrl.replace(/\/$/, '')}${url}`
    }

    return `https://webshot.adarshrkumar.dev/api/take?url=${encodeURIComponent(fullUrl)}&viewport_width=${imageSize}&viewport_height=${imageSize}`
}

// Data loading and processing
// Load and filter portfolio items
const portfolioItemsObj = import.meta.glob('../../content/work/portfolio/*.md', { eager: true })
const portfolioItems: PortfolioItem[] = filterVisibleItems(Object.values(portfolioItemsObj).filter((item): item is PortfolioItem => {
    return !!(item && typeof item === 'object' && 'file' in item && 'frontmatter' in item)
}))

---

<Layout title="Portfolio">
    <SiteGridContent classItems="portfolio wrap" options={{ min: '18rem' }}>
        {
            portfolioItems.map(async (item, itemIndex) => {
                const portfolioUrl = item.frontmatter.url
                const linkTarget = item.frontmatter.target || determineLinkTarget(portfolioUrl, Astro.site)
                const screenshotUrl = generateScreenshotUrl(portfolioUrl)
                const placeholderUrl = `${screenshotUrl}&image_quality=50`

                return (
                    <AnimatedCard index={itemIndex} class="item" href={portfolioUrl} target={linkTarget}>
                        <img
                            src={screenshotUrl}
                            alt={`Screenshot of ${item.frontmatter.name}`}
                            class="item__img"
                            style={`--placeholder: url('${placeholderUrl}')`}
                        />
                        <div class="item__info">
                            <h3 class="item__title">{item.frontmatter.name}</h3>
                            <p class="item__content">{sanitizeMD(item.rawContent())}</p>
                        </div>
                    </AnimatedCard>
                )
            })
        }
    </SiteGridContent>
</Layout>