{
    "extends": "astro/tsconfigs/base",
    "moduleResolution": "nodenext",
    "compilerOptions": {
        "strict": true,
        "strictNullChecks": true,
        "allowJs": true,
        "module": "ESNext",
        "target": "ESNext",
        "jsx": "preserve",
        "jsxImportSource": "astro"
    },
    "exclude": ["node_modules", "dist"]
}